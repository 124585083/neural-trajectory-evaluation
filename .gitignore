# Large intermediate formats
*.zarr/
*.parquet.brotli

# Model and data payloads are external pending redistribution clearance.
*.pt
*.pth
*.pkl
*.npz

# Private Mental-Pong locations and local verification outputs.
experiments/05_mental_pong/configs/paths.local.json
experiments/05_mental_pong/local_outputs/
# Mental-Pong label payloads require a documented redistribution basis.
experiments/05_mental_pong/trajectory_project/condition_endpoint_fa_gpfa_v1/data/*_condition_time_index.csv

