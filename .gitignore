# Local environments and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.codex/
.codex_review/

# Sensorium data are obtained from the official source.
data/*
