# Local environments and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.codex/
.codex_review/

# Sensorium data are obtained from the official source.
data/*
!data/.gitkeep

# Recomputed artifacts are not versioned. Curated small tables live in results/.
outputs/
**/outputs/
predictions/
**/predictions/
checkpoints/
**/checkpoints/
logs/
**/logs/
submissions/
**/submissions/
artifacts/
**/artifacts/

# Large intermediate formats
*.zarr/
*.parquet.brotli

# Model parameters intentionally published under the top-level models/ folder.
*.pt
*.pth
*.pkl
*.npz
!models/**/*.pt
!models/**/*.pth
!models/**/*.pkl
!models/**/*.npz

# Private Mental-Pong locations and local verification outputs.
experiments/05_mental_pong/configs/paths.local.json
experiments/05_mental_pong/local_outputs/
# Compact, immutable labels are the only published Mental-Pong binary inputs.
!experiments/05_mental_pong/trajectory_project/condition_endpoint_fa_gpfa_v1/artifacts/
experiments/05_mental_pong/trajectory_project/condition_endpoint_fa_gpfa_v1/artifacts/*
!experiments/05_mental_pong/trajectory_project/condition_endpoint_fa_gpfa_v1/artifacts/*_condition_labels.npz

/docs/REVISION_REPORT.md
